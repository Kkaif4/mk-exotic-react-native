{
  "name": "mk-exotix-native",
  "version": "1.0.0",
  "private": true,
  "description": "MK Exotic Fruits - Native Offline-First Billing & Ledger System",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web && node -e \"const f='dist/index.html';let c=require('fs').readFileSync(f,'utf8');c=c.replace(/src=\\\"/g, 'src=\\\"./').replace(/href=\\\"/g, 'href=\\\"./');require('fs').writeFileSync(f,c);\"",
    "build:exe": "npm run build:web && npx electron-builder --win --x64"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-status-bar": "~2.0.0",
    "jspdf": "^4.2.1",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3"
  }
}
