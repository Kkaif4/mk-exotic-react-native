{
  "expo": {
    "name": "MK Exotic Fruits",
    "slug": "mk-exotix-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#071629"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mkexoticfruits.nativeapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#071629"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    }
  }
}
